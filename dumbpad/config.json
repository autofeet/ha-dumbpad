{
  "name": "DumbPad",
  "version": "1.0.5-4",
  "slug": "dumbpad",
  "description": "DumbPad with a compact single-row toolbar and persistent notes",
  "url": "https://github.com/autofeet/ha-dumbpad",
  "arch": ["amd64"],
  "startup": "application",
  "boot": "auto",
  "legacy": true,
  "ports": {"3000/tcp": 3926},
  "map": [{"type": "app_config", "path": "/app/data", "read_only": false}],
  "webui": "http://[HOST]:[PORT:3000]",
  "watchdog": "tcp://[HOST]:3000",
  "backup": "cold",
  "options": {"DUMBPAD_PIN": "", "TZ": "Asia/Shanghai"},
  "schema": {"DUMBPAD_PIN": "password", "TZ": "str"}
}
